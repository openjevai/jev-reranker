# TypeSafe API key (environment values take precedence)
TYPESAFE_API_KEY=
# Optional model override
# JEV_MODEL=jev-latest
# Optional complete endpoint URL
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone

# OpenJEV — free community gateway to the same Jev model.
# Set JEV_PROVIDER=openjev to use it explicitly, or leave TYPESAFE_API_KEY
# empty and set OPENJEV_API_KEY to auto-select OpenJEV.
# OPENJEV_API_KEY=
# JEV_PROVIDER=openjev
# When using OpenJEV the model defaults to "openjev" and the endpoint to
# https://api.openjev.sh/v1/systemone; override with JEV_MODEL / endpoint=.
